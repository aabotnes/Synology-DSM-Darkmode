#!/bin/sh
# Turning the package on or off swaps the served stylesheet between the theme
# and an empty file. DSM keeps importing it either way, so no root is needed.

DARKMODE="$SYNOPKG_PKGDEST/bin/darkmode"
export DARKMODE_PKG_DIR="$SYNOPKG_PKGDEST" DARKMODE_VAR_DIR="$SYNOPKG_PKGVAR"

case "$1" in
    start)
        echo 1 > "$SYNOPKG_PKGVAR/enabled"
        "$DARKMODE" render
        if ! "$DARKMODE" status | grep -q '^hooked'; then
            echo "Dark mode is on, but the one-time setup has not run yet. Open the Dark Mode app for the steps." > "$SYNOPKG_TEMP_LOGFILE"
        fi
        exit 0
        ;;
    stop)
        echo 0 > "$SYNOPKG_PKGVAR/enabled"
        "$DARKMODE" render
        exit 0
        ;;
    status)
        [ "$(cat "$SYNOPKG_PKGVAR/enabled" 2>/dev/null)" = "1" ] && exit 0
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
