#!/bin/sh
# DSM Dark Mode helper.
#
#   darkmode apply    hook the dark stylesheet into DSM's web UI   (needs root)
#   darkmode revert   remove the hook and restore DSM's styles     (needs root)
#   darkmode status   show whether the hook is in place
#   darkmode render   rebuild the served stylesheet (used by start/stop)
#
# The hook is a single @import line at the top of DSM's desktop.css that pulls
# in /webman/3rdparty/DarkMode/dark.css, a file this package serves itself.
# Starting/stopping the package fills/empties that file, so dark mode can be
# toggled from Package Center without root. "apply" also regenerates dark
# overrides from every stylesheet installed on the NAS (gen_dark.py). It is
# idempotent and is meant to run from a boot-up task so the hook and the
# generated theme follow DSM and package updates.

PKG=DarkMode
PKG_DIR=${DARKMODE_PKG_DIR:-/var/packages/$PKG/target}
VAR_DIR=${DARKMODE_VAR_DIR:-/var/packages/$PKG/var}
CSS_DIR=${DARKMODE_CSS_DIR:-/usr/syno/synoman/webman/resources/css}
TARGETS=${DARKMODE_TARGETS:-desktop.css}
SCAN_ROOTS=${DARKMODE_SCAN_ROOTS:-"/usr/syno/synoman /var/packages/*/target/ui"}
MARK="/*DSM-DARKMODE*/"
IMPORT="${MARK}@import url(\"/webman/3rdparty/$PKG/dark.css\");"

need_root() {
    if [ "$(id -u)" != "0" ] && [ -z "$DARKMODE_SKIP_ROOT_CHECK" ]; then
        echo "error: '$1' must run as root (use a root Task Scheduler task or sudo)" >&2
        exit 1
    fi
}

# Write $2 into $1 in place, so DSM's owner and permissions stay untouched.
overwrite() {
    cat "$2" > "$1" && rm -f "$2"
}

# nginx serves the pre-compressed .gz when it exists, so keep it in sync.
refresh_gz() {
    [ -f "$1.gz" ] || return 0
    tmp="$1.gz.darkmode.$$"
    gzip -9 -c "$1" > "$tmp" && overwrite "$1.gz" "$tmp"
}

# Build overrides from the stylesheets on this NAS. Without Python the
# hand-written theme in share/dark.css is used on its own.
generate() {
    py=$(command -v python3 || ls /usr/bin/python3* /usr/local/bin/python3* 2>/dev/null | head -n 1)
    if [ -z "$py" ]; then
        echo "warning: python3 not found, using the built-in theme only"
        return 0
    fi
    echo "python: $py ($("$py" --version 2>&1))"
    mkdir -p "$VAR_DIR"
    # shellcheck disable=SC2086  # SCAN_ROOTS holds globs on purpose
    if "$py" "$PKG_DIR/bin/gen_dark.py" --bundle "$PKG_DIR/ui/dsm-styles.tgz" "$VAR_DIR/generated.css" $SCAN_ROOTS 2>&1; then
        chmod 644 "$VAR_DIR/generated.css" "$PKG_DIR/ui/dsm-styles.tgz"
    else
        echo "warning: could not generate the theme from DSM's styles"
    fi
}

# Write the stylesheet DSM imports: the theme when enabled, empty otherwise.
render() {
    out="$PKG_DIR/ui/dark.css"
    tmp="$out.tmp.$$"
    if [ "$(cat "$VAR_DIR/enabled" 2>/dev/null)" != "1" ]; then
        echo "/* DSM Dark Mode is stopped. */" > "$tmp"
    else
        {
            [ "$(cat "$VAR_DIR/mode" 2>/dev/null)" = "auto" ] && echo "@media (prefers-color-scheme: dark) {"
            cat "$PKG_DIR/share/dark.css"
            cat "$VAR_DIR/generated.css" 2>/dev/null
            cat "$PKG_DIR/share/fixes.css"
            [ "$(cat "$VAR_DIR/mode" 2>/dev/null)" = "auto" ] && echo "}"
        } > "$tmp"
    fi
    if [ -f "$out" ]; then overwrite "$out" "$tmp"; else mv "$tmp" "$out"; fi
    # The generated theme can be large; let nginx serve a compressed copy.
    gzip -9 -c "$out" > "$out.gz.tmp" && { if [ -f "$out.gz" ]; then overwrite "$out.gz" "$out.gz.tmp"; else mv "$out.gz.tmp" "$out.gz"; fi; }
}

is_hooked() {
    grep -qF "$MARK" "$1" 2>/dev/null
}

apply() {
    need_root apply
    hooked=0
    for name in $TARGETS; do
        f="$CSS_DIR/$name"
        if [ ! -f "$f" ]; then
            echo "skip: $f not found (unsupported DSM version?)" >&2
            continue
        fi
        if is_hooked "$f"; then
            echo "ok: $f already hooked"
            hooked=1
            continue
        fi
        mkdir -p "$VAR_DIR/backup"
        cp -p "$f" "$VAR_DIR/backup/$name"
        [ -f "$f.gz" ] && cp -p "$f.gz" "$VAR_DIR/backup/$name.gz"

        # @import must come first; only an @charset rule may precede it.
        tmp="$f.darkmode.$$"
        if head -n 1 "$f" | grep -q '^@charset'; then
            { head -n 1 "$f"; echo "$IMPORT"; tail -n +2 "$f"; } > "$tmp"
        else
            { echo "$IMPORT"; cat "$f"; } > "$tmp"
        fi
        overwrite "$f" "$tmp" || { echo "error: could not write $f" >&2; exit 1; }
        refresh_gz "$f"
        echo "hooked: $f"
        hooked=1
    done
    if [ "$hooked" = "1" ]; then
        generate
        render
        echo "Dark mode hook is in place. Reload DSM in your browser."
    else
        echo "error: no DSM stylesheet could be hooked" >&2
        exit 1
    fi
}

revert() {
    need_root revert
    for name in $TARGETS; do
        f="$CSS_DIR/$name"
        is_hooked "$f" || continue
        tmp="$f.darkmode.$$"
        grep -vF "$MARK" "$f" > "$tmp"
        overwrite "$f" "$tmp" || { echo "error: could not write $f" >&2; exit 1; }
        refresh_gz "$f"
        echo "restored: $f"
    done
    echo "DSM styles restored. Reload DSM in your browser."
}

status() {
    for name in $TARGETS; do
        if is_hooked "$CSS_DIR/$name"; then
            echo "hooked: $CSS_DIR/$name"
        else
            echo "not hooked: $CSS_DIR/$name"
        fi
    done
    if [ -s "$PKG_DIR/ui/dark.css" ] && grep -q '{' "$PKG_DIR/ui/dark.css"; then
        echo "theme: on ($(cat "$VAR_DIR/mode" 2>/dev/null || echo always))"
    else
        echo "theme: off (package stopped)"
    fi
}

case "$1" in
    apply)
        # Keep a copy of the output where the Dark Mode app can show it.
        log="$VAR_DIR/last-run.txt"
        mkdir -p "$VAR_DIR"
        ( date '+%Y-%m-%d %H:%M:%S'; apply ) > "$log.tmp" 2>&1
        rc=$?
        cat "$log.tmp"
        mv "$log.tmp" "$log"
        chmod 644 "$log"
        [ -d "$PKG_DIR/ui" ] && cp "$log" "$PKG_DIR/ui/last-run.txt" && chmod 644 "$PKG_DIR/ui/last-run.txt"
        exit $rc
        ;;
    revert) revert ;;
    status) status ;;
    render) render ;;
    *) echo "usage: $0 {apply|revert|status|render}" >&2; exit 2 ;;
esac
